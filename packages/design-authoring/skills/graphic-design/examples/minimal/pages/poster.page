background:
  type: solid
  color: "#F7F6F2"
elements:
  - elementId: band
    elementType: shape
    bounds: [0, 0, 720, 160]
    shapeName: rect
    fill:
      type: solid
      color: "#1F6B8A"
  - elementId: title
    elementType: text
    bounds: [48, 48, 624, 96]
    content:
      text: "A clear title"
      fontSize: 56
      bold: true
      color: "#111111"
  - elementId: photo
    elementType: image
    bounds: [48, 200, 300, 300]
    src: media/swatch.png
    fit:
      mode: cover
    cropShape:
      shapeName: roundRect
  - elementId: star-badge
    elementType: shape
    bounds: [400, 220, 120, 120]
    shapeName: custom
    viewBox: [100, 100]
    path: "M50,0 L61,35 L98,35 L68,57 L79,91 L50,70 L21,91 L32,57 L2,35 L39,35 Z"
    fill:
      type: solid
      color: "#E8A020"
